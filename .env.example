POSTGRES_DB=hni_pos
POSTGRES_USER=hni_pos
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://hni_pos:change-me-local@localhost:5432/hni_pos?schema=public
REDIS_URL=redis://localhost:6379
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters
# Optional S3-compatible image storage (AWS S3 or Cloudflare R2). Leave blank to disable image uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Optional daily database backup bucket. Requires S3 credentials above; keeps 30 days.
S3_BACKUP_BUCKET=
# Optional SMTP delivery for daily owner reports. Disabled unless configured and enabled per tenant.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Discounts at or above this share of the subtotal are flagged in owner audit logs (review only).
FRAUD_DISCOUNT_RATE_THRESHOLD=0.70
# Optional WhatsApp gateway for sending receipts (fonnte | wablas | mock). Disabled unless provider and token are set (mock needs no token).
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WABLAS_BASE_URL=
WHATSAPP_TIMEOUT_MS=5000
# Optional Midtrans billing (Day 25). Empty = sandbox mock mode, no real charge.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Optional error tracking (Day 27). Empty = in-memory capture only.
SENTRY_DSN=
# Optional ops alerts (Day 27). Empty = mock mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
# Public web URL used in receipt links sent by WhatsApp (defaults to NEXT_PUBLIC_SITE_URL).
PUBLIC_SITE_URL=
# Number of reverse-proxy hops to trust for client IPs (set 1 behind Caddy; 0 when exposed directly).
TRUST_PROXY=0
