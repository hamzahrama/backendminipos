# Copy to .env.production on the server, set strong random secrets, and never commit it.
DOMAIN=store.example.com
API_DOMAIN=api.store.example.com
ACME_EMAIL=ops@example.com
NEXT_PUBLIC_SITE_URL=https://store.example.com
NEXT_PUBLIC_API_URL=https://api.store.example.com

POSTGRES_DB=hni_pos
POSTGRES_USER=hni_pos
# Use URL-safe characters (letters/numbers) to avoid DATABASE_URL escaping errors.
POSTGRES_PASSWORD=replace-with-a-long-random-value
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters

CORS_ORIGINS=https://store.example.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_BACKUP_BUCKET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRAUD_DISCOUNT_RATE_THRESHOLD=0.70
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WABLAS_BASE_URL=
WHATSAPP_TIMEOUT_MS=5000
